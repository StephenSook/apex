# APEX environment-variable slots. Copy to `.env.local` (Next.js auto-loads)
# OR `.env` (Vinh backend auto-loads via python-dotenv) + fill the values.
#
# `.env*` files are gitignored per `.gitignore`. NEVER commit real keys.
#
# Wave-42 Lane F.B per docs/vinh-phase-1-handoff.md Q2 decision (OpenRouter
# primary; watsonx.ai bonus track).

# ---------------------------------------------------------------------------
# OpenRouter (Phase 1 primary LLM path; D-019 plan task 5.1 alignment)
# ---------------------------------------------------------------------------

# OpenRouter API key. Format: sk-or-v1-<hex>.
# Source: https://openrouter.ai/keys (Stephen-side standup; key DM-ed to Vinh).
OPENROUTER_API_KEY=

# OpenRouter base URL. OpenAI-compatible REST surface.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter Granite model slug. Verify the exact slug via the OpenRouter
# model catalog at https://openrouter.ai/models when standing up the
# integration. The wave-30 architecture spec assumes "ibm-granite/granite-4.1-
# 8b-instruct" or similar. PLACEHOLDER; Vinh swaps to the verified slug.
OPENROUTER_MODEL=

# Optional: OpenRouter HTTP-Referer header (recommended by OpenRouter for
# rate-limit grouping + leaderboard attribution). Set to the apex.race
# production URL when shipping.
OPENROUTER_HTTP_REFERER=https://apex.race

# Optional: OpenRouter X-Title header (display name shown on OpenRouter
# dashboard + leaderboard).
OPENROUTER_X_TITLE=APEX AI Race Engineer

# ---------------------------------------------------------------------------
# watsonx.ai (Phase 4 / Phase 5 bonus track for "Best Use of IBM Tech" if
# runway permits; per Vinh handoff Q2 decision)
# ---------------------------------------------------------------------------

# IBM Cloud IAM API key. Source: https://cloud.ibm.com/iam/apikeys.
IBM_CLOUD_API_KEY=

# watsonx.ai project ID. Source: https://dataplatform.cloud.ibm.com/wx/
# project home page > Manage > General > Project ID.
WATSONX_PROJECT_ID=

# watsonx.ai region URL. Common values: us-south, eu-de, jp-tok.
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# watsonx.ai Granite model ID. Verify in the watsonx.ai model catalog.
# Common: ibm/granite-3-8b-instruct or ibm/granite-4-1-8b-instruct.
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ---------------------------------------------------------------------------
# Watson Text-to-Speech (Lane A.F.1 walkie-talkie audio per PitWall pattern)
# ---------------------------------------------------------------------------

# IBM Cloud Watson TTS API key. Source: https://cloud.ibm.com/services/text-to-speech.
WATSON_TTS_API_KEY=

# Watson TTS service URL.
WATSON_TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com

# Watson TTS voice. Common values: en-US_AllisonV3Voice,
# en-GB_KateV3Voice, en-US_LisaV3Voice.
WATSON_TTS_VOICE=en-GB_KateV3Voice
